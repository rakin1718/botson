# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Local Telegram bot state must not be included in deployment artifacts.
bots/telegram-bot/*.sqlite3
bots/telegram-bot/*.sqlite3-shm
bots/telegram-bot/*.sqlite3-wal
bots/telegram-bot/*.session*
__pycache__/
*.py[cod]
